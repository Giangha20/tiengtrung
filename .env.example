# =========================
# OTP SMTP - Gmail
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=yourgmail@gmail.com

# =========================
# CORS - GitHub Pages frontend
# =========================
FRONTEND_ORIGIN=https://giangha20.github.io

