rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A signed-in user may only access their own document.
      // The immutable identity fields must remain bound to Firebase Auth.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /favorites/{wordId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /notes/{wordId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
