{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "login.html",
          "register.html",
          "forgot-password.html",
          "forgot_password.html",
          "manifest.json",
          "*.css",
          "*.js",
          "*.json",
          "*.jpg",
          "*.png"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
